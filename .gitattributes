# Keep extracted font metadata/license byte-for-byte identical to local assets.
assets/minecraft_hud/font_default.json -text
assets/minecraft_hud/UNIFONT_LICENSE.txt -text -whitespace

# Generated execution logs stay available but are hidden in GitHub diffs by default.
docs/evidence/**/*.log linguist-generated=true

# Frozen behavioral oracles are byte-addressed evidence, not native text.
# Preserve their committed bytes even when Windows core.autocrlf is enabled.
tests/fixtures/** -text

# Verified native menu packs are byte-addressed, including JSON/shader/licenses.
# Git newline conversion must not corrupt a transferred pack's file hashes.
rm_client/ui/endfield/menu/assets/** -text -whitespace

# Wiki images, curves, fonts and licenses share a byte-addressed runtime manifest.
rm_client/ui/endfield/wiki/assets/** -text -whitespace

# Official announcement page resources and game SDK fonts use byte-addressed provenance.
rm_client/ui/endfield/changelog/assets/** -text -whitespace

# Settings and standalone keyboard assets include byte-addressed JSON curves.
rm_client/ui/endfield/settings/assets/** -text -whitespace
rm_client/ui/endfield/keybinds/assets/** -text -whitespace

# Original CS2 exports are hash-addressed vendor evidence.
assets/cs2_scoreboard_source/** -text -whitespace
assets/endfield_settings/** -text -whitespace

# Jello UI images/fonts/samples are moved without changing any asset bytes.
rm_client/ui/jello/**/assets/** -text
