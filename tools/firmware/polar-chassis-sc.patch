diff --git a/application/communication/usb_task.c b/application/communication/usb_task.c
index c5e92b1..d048cc7 100644
--- a/application/communication/usb_task.c
+++ b/application/communication/usb_task.c
@@ -124,6 +124,10 @@ static const ground_robot_position_t * GROUND_ROBOT_POSITION;
 // 判断USB连接状态用到的一些变量
 static bool USB_OFFLINE = true;
 static uint32_t RECEIVE_TIME = 0;
+/* 专属于驾驶指令流（上行 0x01 RobotCmd）的接收时刻。
+ * 不能用 RECEIVE_TIME 代替：后者对任意 CRC 通过的包（调参包、虚拟遥控器包等）都刷新，
+ * 会导致“0x01 已断流但其他包还在发”时底盘带着最后一帧速度一直跑。 */
+static uint32_t ROBOT_CMD_RECEIVE_TIME = 0;
 static uint32_t LATEST_RX_TIMESTAMP = 0;
 static uint32_t CONTINUE_RECEIVE_CNT = 0;
 
@@ -685,6 +689,7 @@ static void UsbReceiveData(void)
                 switch (data_id) {
                     case ROBOT_CMD_DATA_RECEIVE_ID: {
                         memcpy(&RECEIVE_ROBOT_CMD_DATA, sof_address, sizeof(ReceiveDataRobotCmd_s));
+                        ROBOT_CMD_RECEIVE_TIME = HAL_GetTick();
                     } break;
                     case PID_DEBUG_DATA_RECEIVE_ID: {
                         memcpy(&RECEIVE_PID_DEBUG_DATA, sof_address, sizeof(ReceiveDataPidDebug_s));
@@ -1344,4 +1349,54 @@ inline bool GetSCcmdtracking(void)
 {
     return ROBOT_CMD_DATA.tracking.tracking;
 }
+
+/**
+ * @brief          获取USB上位机在线状态
+ * @param[in]      none
+ * @retval         1: 在线；0: 已按 USB_OFFLINE_THRESHOLD 判离线
+ * @warning        定义必须留在本文件：USB_OFFLINE 是 static，
+ *                 挖到头文件里会立刻编译失败。
+ */
+inline uint8_t GetUsbStatus(void)
+{
+    return USB_OFFLINE ? 0 : 1;
+}
+
+/**
+ * @brief          获取距最后一帧**驾驶指令（上行 0x01 RobotCmd）**的毫秒数
+ * @param[in]      none
+ * @retval         uint32_t 距今毫秒数；驾驶指令停发后持续增长
+ * @note           消费者侧用它做断流归零。不要在 USB_OFFLINE 分支里集中
+ *                 memset 控制量，那会把云台 AUTO_AIM 的目标角突降为 0 导致甩杆。
+ *                 本函数故意不用 RECEIVE_TIME：那个变量对任意合法包都刷新，
+ *                 无法反映驾驶指令流是否断了。
+ * @warning        定义必须留在本文件：USB_OFFLINE 与 ROBOT_CMD_RECEIVE_TIME
+ *                 都是 static，挖到头文件里会立刻编译失败。
+ */
+inline uint32_t GetScCmdAge(void)
+{
+    return HAL_GetTick() - ROBOT_CMD_RECEIVE_TIME;
+}
+
+/**
+ * @brief          获取上位机控制指令：底盘姿态，基于欧拉角 r x p x y
+ * @param[in]      axis: AX_X/AX_Y/AX_Z
+ * @retval         float (rad) 底盘姿态
+ */
+inline float GetScCmdChassisAngle(uint8_t axis)
+{
+    if (axis == AX_X)
+    {
+        return ROBOT_CMD_DATA.chassis.roll;
+    }
+    else if (axis == AX_Y)
+    {
+        return ROBOT_CMD_DATA.chassis.pitch;
+    }
+    else if (axis == AX_Z)
+    {
+        return ROBOT_CMD_DATA.chassis.yaw;
+    }
+    return 0.0f;
+}
