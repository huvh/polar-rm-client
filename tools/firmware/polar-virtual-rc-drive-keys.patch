+// 形成 merge-vs-clear 竞态（车速按占空比抖动、最差情况完全不响应）。
+// 无键盘的遥控器没有“拥有” key.v 的资格，因此不应当写它。
 #define SPECIAL_CHANNEL_SET_SERO()\
     rc_ctrl->mouse.x = 0;         \
     rc_ctrl->mouse.y = 0;         \
     rc_ctrl->mouse.z = 0;         \
     rc_ctrl->mouse.press_l = 0;   \
     rc_ctrl->mouse.press_r = 0;   \
-    rc_ctrl->key.v = 0;           \
     rc_ctrl->rc.ch[4] = 0;        \
 
 #if (__RC_TYPE == RC_AT9S_PRO)
